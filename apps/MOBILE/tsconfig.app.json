{
  "extends": "./tsconfig.json",
  "references": [
    {
      "path": "../../libs/design-tokens/tsconfig.json"
    }
  ],
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "moduleResolution": "bundler",
    "types": ["node"],
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@mobile/*": ["./*"],
      "@/*": ["./*"]
    }
  },
  "files": ["../../node_modules/@nx/react-native/typings/svg.d.ts"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx",
    "src/test-setup.ts"
  ],
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.js",
    "src/**/*.jsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "utils/**/*.ts",
    "utils/**/*.tsx",
    "hooks/**/*.ts",
    "hooks/**/*.tsx",
    "backend/**/*.ts",
    "store/**/*.ts",
    "screens/**/*.tsx",
    "navigation/**/*.tsx",
    "types/**/*.ts",
    "types/**/*.d.ts",
    "nativewind-env.d.ts"
  ]
}
